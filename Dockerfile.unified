# ─── Stage 1: Build Hermes Workspace ─────────────────────────────────────
FROM node:22-slim AS workspace_builder

ARG GIT_BRANCH=dev
ARG USE_GIT=false
ARG GIT_REPO=https://github.com/outsourc-e/hermes-workspace.git

ENV CI=true

RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace-src

# Option 1: Local build (default) - copy from build context
# Option 2: Git build - clone from repository
COPY hermes-workspace/package.json hermes-workspace/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY hermes-workspace/ .
RUN pnpm build

# ─── Stage 2: Production Unified Image ───────────────────────────────────
FROM nousresearch/hermes-agent:latest AS final

USER root

# Define workspace directories
ENV WORKSPACE_DIR=/opt/hermes-workspace \
    HERMES_WORKSPACE_DIR=/workspace \
    PORT=3000

WORKDIR ${WORKSPACE_DIR}

# Copy Workspace build artifacts + runtime deps from Stage 1
COPY --from=workspace_builder --chown=hermes:hermes /workspace-src/dist ./dist
COPY --from=workspace_builder --chown=hermes:hermes /workspace-src/node_modules ./node_modules
COPY --from=workspace_builder --chown=hermes:hermes /workspace-src/package.json ./package.json
COPY --from=workspace_builder --chown=hermes:hermes /workspace-src/server-entry.js ./server-entry.js
COPY --from=workspace_builder --chown=hermes:hermes /workspace-src/skills ./skills

# ─── Stage 3: s6-overlay Process Supervision Wiring ──────────────────────
# Upstream reworked gateway supervision: gateway is now a *dynamic* per-profile
# s6 service registered at boot by /etc/cont-init.d/02-reconcile-profiles, not a
# static s6-rc.d slot. We trigger it via CMD ["gateway","run"] below: PID 1's argv
# contains the "gateway run" tokens, which container_boot._is_legacy_gateway_run_request
# detects and seeds gateway_state.json=running on the volume, so 02-reconcile
# auto-starts the gateway-default slot → :8642 comes up.
#
# (We used to declare a static "gateway" s6 service here running `hermes gateway
#  run --replace`; that collided with the upstream dynamic gateway-default slot —
# both `--replace`d each other and the container SIGTERMd itself. Removed.)

# Declare 'workspace' as a new service directory for s6-overlay
RUN mkdir -p /etc/s6-overlay/s6-rc.d/workspace /etc/s6-overlay/s6-rc.d/workspace/dependencies.d && \
    # 1. Define service type as 'longrun'
    echo "longrun" > /etc/s6-overlay/s6-rc.d/workspace/type && \
    # 2. Dependencies: dashboard (:9119) must be ready. The gateway (:8642) is now
    #    a boot-time dynamic slot, not a statable s6 dep, so workspace connects to
    #    HERMES_API_URL=http://127.0.0.1:8642 at runtime and tolerates a slow start.
    touch /etc/s6-overlay/s6-rc.d/workspace/dependencies.d/dashboard && \
    # 3. Enable the service by linking it inside the 'user' bundle
    touch /etc/s6-overlay/s6-rc.d/user/contents.d/workspace

# 4. Create the s6 runner script for Workspace
RUN printf '#!/command/with-contenv sh\n\
export HOME=/opt/data\n\
export NODE_ENV=production\n\
export HERMES_API_URL=http://127.0.0.1:8642\n\
export HERMES_DASHBOARD_URL=http://127.0.0.1:9119\n\
export HERMES_HOME=/opt/data\n\
export HERMES_WORKSPACE_DIR=/workspace\n\
cd %s\n\
exec s6-setuidgid hermes node server-entry.js\n' "${WORKSPACE_DIR}" > /etc/s6-overlay/s6-rc.d/workspace/run && \
    chmod +x /etc/s6-overlay/s6-rc.d/workspace/run

# Expose ports
# 3000 -> Workspace UI
# 8642 -> Optional Agent Open-API Gateway
EXPOSE 3000 8642

# Restore ENTRYPOINT to /init (main-wrapper.sh is the system-program via /run/s6/container_environment).
# CMD ["gateway", "run"] makes PID 1's argv contain the legacy `gateway run` tokens,
# so container_boot seeds gateway_state.json=running and 02-reconcile auto-starts the
# dynamic gateway-default slot → :8642 for the workspace server to reach.
ENTRYPOINT [ "/init", "/opt/hermes/docker/main-wrapper.sh" ]
CMD [ "gateway", "run" ]
