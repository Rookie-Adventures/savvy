# 机B 部署环境变量样例 — 拷贝为 .env 并改密码 (不入仓库)
# cp .env.example .env && 填入真实值

# Redis 密码 (跟 docker-compose.yml 里 REDIS_CONN_STRING 替换一致)
REDIS_PASSWORD=改我

# new-api Session Secret (随机 64 字符, openssl rand -hex 32)
SESSION_SECRET=改我_随机64字符

# savvy-manager B层 LLM 密钥加密 key (32 字符)
SAVVY_PROVIDER_ENC_KEY=改我_32字符随机

# savvy-manager 与 new-api 的 HMAC 签名密钥 (dev/prod 必须一致)
SAVVY_HMAC_SECRET=改我
