# 机B 部署环境变量样例 — 拷贝为 .env 并改密码 (不入仓库)
# cp .env.example .env && 填入真实值

# Redis 密码 (跟 docker-compose.yml 里 REDIS_CONN_STRING 替换一致)
REDIS_PASSWORD=改我

# new-api Session Secret (随机 64 字符, openssl rand -hex 32)
SESSION_SECRET=改我_随机64字符

# savvy-manager B层 LLM 密钥加密 key (32 字符)
SAVVY_PROVIDER_ENC_KEY=改我_32字符随机

# savvy-manager 与 new-api 的 HMAC 签名密钥 (dev/prod 必须一致)
SAVVY_HMAC_SECRET=改我

# ============ 蚂蚁链订单存证 (可选, 不配 = 存证关闭, 支付照跑) ============
# 私钥文件不放仓库/不入镜像, 宿主机 chmod 600, 容器只读挂载(见 docker-compose volumes)。
# 启用步骤:
#   1. 机B宿主机: mkdir -p /opt/savvy/secrets && 放 access.key && chmod 600
#   2. .env 填下面 ANTCHAIN_* (ACCESS_SECRET_FILE 指向容器内挂载路径)
#   3. docker-compose up -d (new-api 会自动 Init 并接管支付回调存证)
# 不填 ANTCHAIN_ENABLED=true 则包静默(Init 不握手), 支付链不受影响。
# 注意: 握手失败也装钩子(design.md line160) — 配错时运行期每单 SysError 逼排查。
# 用 SDK B 类认证(AccessId + RSA 私钥 + shake), 不走 wt-token 后缀 REST URL。
# 合约 0x8d9ce16a...47f6703ed2907656e24bfc2c477f8f45 已正式上链, design 见
# docs/superpowers/specs/2026-07-18-antchain-order-evidence-design.md。
ANTCHAIN_ENABLED=false
# 已知真值 (沙箱与正式共用, 链上已正式部署):
ANTCHAIN_ACCESS_ID=pnv3kEhXTWHRFGOY
ANTCHAIN_ACCESS_SECRET_FILE=/secrets/antchain-access.key
# 裸 host! 别带 /w3/api/.../wt-token 后缀 (那是另一套开放联盟链接口, 本 SDK 不支持):
ANTCHAIN_REST_URL=https://rest.baas.alipay.com
ANTCHAIN_ACCOUNT=savvy
ANTCHAIN_CONTRACT_NAME=savvy-solidity
ANTCHAIN_BIZ_ID=
ANTCHAIN_TENANT_ID=
ANTCHAIN_KMS_ID=7ysf2UgpTWHRFGOY1783011006931
ANTCHAIN_GAS=0
